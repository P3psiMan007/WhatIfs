{
  "name": "whatifs-factory",
  "version": "0.1.0",
  "description": "What If Explains automated video factory: Remotion rendering engine + production tooling",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "typecheck": "tsc",
    "lint": "eslint src",
    "test": "node --test",
    "render:test": "remotion render FactoryTest out/factory-test.mp4",
    "episode:next": "node tools/orchestrator.mjs",
    "episode:state": "node tools/episode-state.mjs show",
    "voice:audition": "node tools/voice/generate-auditions.mjs",
    "voice:narration": "node tools/voice/generate-narration.mjs",
    "qa:technical": "node tools/qa/run-technical-qa.mjs",
    "render:episode": "node tools/render/render-episode.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@remotion/bundler": "4.0.506",
    "@remotion/cli": "4.0.506",
    "@remotion/media-utils": "4.0.506",
    "@remotion/renderer": "4.0.506",
    "ajv": "^8.20.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "kokoro-js": "^1.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.506"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.506",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "eslint": "9.19.0",
    "typescript": "5.9.3"
  },
  "sideEffects": [
    "*.css"
  ]
}
