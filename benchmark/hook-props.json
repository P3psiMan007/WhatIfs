{
  "durationSeconds": 28.033333333333335,
  "captions": [
    {
      "text": "Tonight, you go to bed for the last time.",
      "start": 0.854,
      "end": 3.512
    },
    {
      "text": "Tomorrow, every human wakes up",
      "start": 4.315,
      "end": 6.868
    },
    {
      "text": "and discovers that sleep is simply unnecessary.",
      "start": 6.888,
      "end": 10.418
    },
    {
      "text": "No fatigue.",
      "start": 11.223,
      "end": 12.268
    },
    {
      "text": "No brain fog.",
      "start": 12.358,
      "end": 13.633
    },
    {
      "text": "No hidden health cost.",
      "start": 13.736,
      "end": 15.432
    },
    {
      "text": "Whatever your body used to repair during sleep",
      "start": 16.148,
      "end": 19.106
    },
    {
      "text": "now happens while you are awake.",
      "start": 19.126,
      "end": 21.706
    },
    {
      "text": "You just gained roughly eight extra hours every day.",
      "start": 22.719,
      "end": 26.581
    }
  ],
