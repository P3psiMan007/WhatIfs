#!/usr/bin/env python3
"""Batch compatibility wrapper for the real edge-tts CLI.

The producer uses --batch-json/--output-dir for efficient per-scene orchestration.
This wrapper preserves that interface while delegating each scene to the exact
requested Edge TTS voice and rate. It never substitutes narrator identity.
"""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path


def real_edge_tts() -> str:
    real = os.environ.get("EDGE_TTS_REAL", "").strip()
    if not real:
        raise SystemExit("EDGE_TTS_REAL is required; refusing narrator fallback")
    return real


def render_batch(batch_json: str, output_dir: str) -> None:
    payload = json.loads(Path(batch_json).read_text(encoding="utf-8"))
    voice = str(payload["voice"]).strip()
    rate = str(payload.get("rate", "+0%")).strip()
    scenes = payload.get("scenes") or []
    if not voice:
        raise SystemExit("batch narration voice is empty; refusing narrator fallback")
    if not scenes:
        raise SystemExit("batch narration contains no scenes")

    out = Path(output_dir)
    out.mkdir(parents=True, exist_ok=True)
    executable = real_edge_tts()
    for index, scene in enumerate(scenes, 1):
        text = str(scene.get("text") or "").strip()
        if not text:
            raise SystemExit(f"empty narration input for scene {index}")
        stem = f"scene-{index:02d}"
        source = out / f"{stem}.txt"
        media = out / f"{stem}.mp3"
        subtitles = out / f"{stem}.srt"
        source.write_text(text + "\n", encoding="utf-8")
        subprocess.run([
            executable,
            "--file", str(source),
            "--voice", voice,
            f"--rate={rate}",
            "--write-media", str(media),
            "--write-subtitles", str(subtitles),
        ], check=True)


def main() -> None:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--batch-json")
    parser.add_argument("--output-dir")
    args, remaining = parser.parse_known_args()
    if args.batch_json:
        if not args.output_dir:
            raise SystemExit("--output-dir is required with --batch-json")
        render_batch(args.batch_json, args.output_dir)
        return

    executable = real_edge_tts()
    os.execv(executable, [executable, *remaining])


if __name__ == "__main__":
    main()
