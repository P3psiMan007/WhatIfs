#!/usr/bin/env python3
"""Compatibility CLI backed by Apache-2.0 Kokoro.

The legacy single-file flags remain supported for compatibility, while
``--batch-json`` renders every scene in one Python process so the Kokoro model
is loaded only once per episode.
"""
import argparse
import json
import re
import subprocess
import tempfile
from pathlib import Path

import numpy as np
import soundfile as sf
from kokoro import KPipeline


def stamp(seconds: float) -> str:
    ms = max(0, round(seconds * 1000))
    h, rem = divmod(ms, 3_600_000)
    m, rem = divmod(rem, 60_000)
    s, ms = divmod(rem, 1000)
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"


def sentences(text: str):
    parts = re.split(r"(?<=[.!?])\s+", re.sub(r"\s+", " ", text.strip()))
    return [p.strip() for p in parts if p.strip()]


def speed_for_rate(rate: str) -> float:
    # Preserve the approved documentary pace. The canonical +4% legacy value
    # intentionally maps to Kokoro 0.92 for extra payoff breathing room.
    speed = 0.92
    m = re.fullmatch(r"([+-]?)(\d+)%", str(rate or "+0%").strip())
    if m and str(rate).strip() not in {"+4%", "4%"}:
        pct = int(m.group(2)) * (-1 if m.group(1) == "-" else 1)
        speed = max(0.78, min(1.08, 0.92 * (1 + pct / 100)))
    return speed


def normalize_voice(voice: str) -> str:
    return voice if str(voice or "").startswith(("af_", "am_", "bf_", "bm_")) else "am_michael"


def render_text(text: str, pipeline, voice: str, speed: float):
    text = str(text or "").strip()
    if not text:
        raise ValueError("empty narration input")

    audio_parts = []
    cues = []
    cursor = 0.0
    for sentence in sentences(text):
        chunks = []
        for _graphemes, _phonemes, audio in pipeline(sentence, voice=voice, speed=speed):
            chunks.append(np.asarray(audio, dtype=np.float32))
        if not chunks:
            continue
        rendered = np.concatenate(chunks)
        duration = len(rendered) / 24000.0
        audio_parts.append(rendered)
        cues.append((cursor, cursor + duration, sentence))
        # Preserve the approved 140 ms scene-internal pause from the prior
        # Kokoro route so batching changes startup cost, not creative pacing.
        silence = np.zeros(round(0.14 * 24000), dtype=np.float32)
        audio_parts.append(silence)
        cursor += duration + 0.14

    if not cues:
        raise ValueError("Kokoro produced no narration")
    return np.concatenate(audio_parts), cues


def write_outputs(audio, cues, media: Path, srt: Path) -> None:
    media.parent.mkdir(parents=True, exist_ok=True)
    srt.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as td:
        wav = Path(td) / "narration.wav"
        sf.write(wav, audio, 24000)
        subprocess.run([
            "ffmpeg", "-y", "-v", "error", "-i", str(wav),
            "-c:a", "libmp3lame", "-b:a", "128k", str(media)
        ], check=True)

    srt.write_text("\n\n".join(
        f"{i}\n{stamp(start)} --> {stamp(end)}\n{text}"
        for i, (start, end, text) in enumerate(cues, 1)
    ) + "\n", encoding="utf-8")


def render_batch(batch_path: Path, output_dir: Path) -> None:
    payload = json.loads(batch_path.read_text(encoding="utf-8"))
    scenes = payload.get("scenes") or []
    if not scenes:
        raise SystemExit("batch narration contains no scenes")

    voice = normalize_voice(payload.get("voice"))
    speed = speed_for_rate(payload.get("rate", "+0%"))
    pipeline = KPipeline(lang_code="a")
    output_dir.mkdir(parents=True, exist_ok=True)

    for index, scene in enumerate(scenes):
        text = str(scene.get("text") or "").strip()
        if not text:
            raise SystemExit(f"empty narration input for scene {index + 1}")
        stem = f"scene-{index + 1:02d}"
        audio, cues = render_text(text, pipeline, voice, speed)
        write_outputs(
            audio,
            cues,
            output_dir / f"{stem}.mp3",
            output_dir / f"{stem}.srt",
        )


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--file")
    p.add_argument("--voice", default="af_heart")
    p.add_argument("--rate", default="+0%")
    p.add_argument("--write-media")
    p.add_argument("--write-subtitles")
    p.add_argument("--batch-json")
    p.add_argument("--output-dir")
    args = p.parse_args()

    if args.batch_json:
        if not args.output_dir:
            raise SystemExit("--output-dir is required with --batch-json")
        render_batch(Path(args.batch_json), Path(args.output_dir))
        return

    if not args.file or not args.write_media or not args.write_subtitles:
        raise SystemExit("legacy mode requires --file, --write-media, and --write-subtitles")

    text = Path(args.file).read_text(encoding="utf-8").strip()
    voice = normalize_voice(args.voice)
    speed = speed_for_rate(args.rate)
    pipeline = KPipeline(lang_code="a")
    audio, cues = render_text(text, pipeline, voice, speed)
    write_outputs(audio, cues, Path(args.write_media), Path(args.write_subtitles))


if __name__ == "__main__":
    main()
